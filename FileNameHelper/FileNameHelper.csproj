<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>FileNameHelper</Title>
    <Authors>AdriansRepos</Authors>
    <Description>Knihovna pro bezpečné použití libovolného textu (jméno, název) jako součásti názvu souboru nebo složky ve Windows.</Description>
    <PackageProjectUrl>https://github.com/AdriansRepos/FileNameHelper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdriansRepos/FileNameHelper</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>1.0.1</Version>
    <PackageReleaseNotes>Oprava chybného názvu balíčku v příkazu pro instalaci.
</PackageReleaseNotes>
    <AssemblyVersion>1.0.1</AssemblyVersion>
    <FileVersion>1.0.1</FileVersion>

  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
